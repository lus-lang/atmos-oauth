local ROOT = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")
local PACKAGES = string.match(ROOT, "^(.*)[/\\][^/\\]*$")
pledge("load", `fs:read=$PACKAGES/*`)
package.path = `$ROOT/?.lus;$PACKAGES/jwt/?.lus;$PACKAGES/atmos-jwt/?.lus;$(package.path)`
-- The package requires jwt by its atmosphere URL. The tests load the
-- checkout next to this one in its place.
package.preload["https://atmosp.here/2.0/jwt.lus"] = function() return require("jwt") end

local oauth = require("oauth")
local jwt = require("jwt")

